generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Conventions
// - Money is an Int in the smallest unit of its currency (cents, centavos).
// - Calendar dates are @db.Date (no time, no zone). The app reads and writes
//   them as "YYYY-MM-DD" strings in the America/Sao_Paulo calendar.
// - Exchange rates are Ints in millionths of a real per unit (5.7324 -> 5732400).

enum Currency {
  USD
  EUR
}

/// Stored invoice status. "Paid", "partly paid" and "overdue" are derived
/// from payments and dates, never stored, so they can't go out of sync.
enum InvoiceStatus {
  DRAFT
  SENT
  VOID
}

enum RateSource {
  PTAX
  MANUAL
}

// ---------- Auth.js + settings ----------

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  // Guest users come from "Try the demo" and are deleted after a day.
  isGuest       Boolean   @default(false)
  createdAt     DateTime  @default(now())

  // Settings. The app never acts on regimeLabel; it is just a note.
  revenueCeilingBRL   Int     @default(8100000) // R$81,000.00 (MEI preset)
  setAsideBasisPoints Int     @default(600) // 6.00%
  regimeLabel         String  @default("")
  // Shown on the invoice PDF.
  businessName        String  @default("")
  businessDetails     String  @default("") // address, tax id, one item per line
  paymentInstructions String  @default("")
  // Last number handed out. Numbers are assigned when an invoice is sent, so
  // deleting a draft never leaves a gap.
  lastInvoiceNumber   Int     @default(0)

  accounts Account[]
  clients  Client[]
  invoices Invoice[]
  payments Payment[]

  @@index([isGuest, createdAt])
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
  @@index([userId])
}

// ---------- Income ----------

model Client {
  id               String    @id @default(cuid())
  userId           String
  name             String
  country          String
  email            String    @default("")
  address          String    @default("")
  defaultCurrency  Currency  @default(USD)
  paymentTermsDays Int       @default(30)
  archivedAt       DateTime?
  createdAt        DateTime  @default(now())

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  invoices Invoice[]

  @@index([userId])
}

model Invoice {
  id               String        @id @default(cuid())
  userId           String
  clientId         String
  /// Null while the invoice is a draft.
  number           Int?
  issueDate        DateTime      @db.Date
  dueDate          DateTime      @db.Date
  currency         Currency
  status           InvoiceStatus @default(DRAFT)
  nfseNumber       String        @default("")
  taxTreatmentNote String        @default("")
  notes            String        @default("") // printed on the PDF
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  user     User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  client   Client        @relation(fields: [clientId], references: [id], onDelete: Restrict)
  items    InvoiceItem[]
  payments Payment[]

  @@unique([userId, number])
  @@index([userId, issueDate])
  @@index([clientId])
}

model InvoiceItem {
  id                 String @id @default(cuid())
  invoiceId          String
  position           Int
  description        String
  /// Quantity times 100, so 7.5 hours is 750.
  quantityHundredths Int
  unitPrice          Int

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
}

model Payment {
  id             String     @id @default(cuid())
  userId         String
  invoiceId      String
  receivedDate   DateTime   @db.Date
  /// In the invoice's currency, minor units.
  amountReceived Int
  /// Reais that reached the bank account, typed by the user. Never overwritten.
  amountBRL      Int
  feesBRL        Int        @default(0)
  /// Reference rate shown next to the real amount.
  rateMicros     Int?
  rateDate       DateTime?  @db.Date
  rateSource     RateSource?
  rateBulletin   String?
  /// The client's bank or an intermediary kept part of the money; treat the
  /// invoice as paid even though amountReceived is short.
  settlesInvoice Boolean    @default(false)
  note           String     @default("")
  createdAt      DateTime   @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([userId, receivedDate])
  @@index([invoiceId])
}

/// Cache of Banco Central PTAX closing rates. Shared by all users, filled on demand.
model ExchangeRate {
  id         String   @id @default(cuid())
  date       DateTime @db.Date
  currency   Currency
  buyMicros  Int
  sellMicros Int
  bulletin   String
  fetchedAt  DateTime @default(now())

  @@unique([date, currency])
}
