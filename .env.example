# Copy this file to `.env` and fill in the values.

# Postgres connection string. Locally, `docker compose up -d` starts a database
# that matches this URL. In production use your Neon or Supabase URL
# (with `?sslmode=require`). Use a SEPARATE database for the public demo.
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/income"

# Secret used to sign session cookies. Generate one with: npx auth secret
# (or: openssl rand -base64 32)
AUTH_SECRET=""

# GitHub OAuth app (https://github.com/settings/developers).
# Callback URL: http://localhost:3000/api/auth/callback/github
# Leave both empty to run with only the guest demo sign-in.
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""

# Set to "false" to hide the "Try the demo" guest sign-in (do this on your
# private deployment that holds real data).
DEMO_MODE_ENABLED="true"
